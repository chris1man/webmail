# Enter real values only in Portainer environment variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_SECRET=
ALERTS_UI_USERNAME=alerts-admin
ALERTS_UI_PASSWORD=

# Private address on mail-network. Leave unchanged unless your Stalwart listener differs.
STALWART_JMAP_URL=http://stalwart:8080/jmap
# API key with sysBlockedIpCreate only. Required for Telegram IP-block buttons.
STALWART_API_TOKEN=
